{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "zig build",
			"command": "zig build",
			"group": "build",
			"isBackground": false,
			"problemMatcher": [
				"$zig"
			]
		},
		{
			"type": "shell",
			"label": "zig build run",
			"command": "zig build run -- ${input:pcidev} ${input:iommu_groupid} -v",
			"group": "build",
			"isBackground": false,
			"problemMatcher": [
				"$zig"
			]
		},
		{
			"type": "shell",
			"label": "zig build test",
			"command": "zig build test",
			"group": "test",
			"isBackground": false,
			"problemMatcher": [
				"$zig"
			]
		},
	],
	"inputs": [
		{
			"id": "pcidev",
			"type": "promptString",
			"description": "PCIデバイスIDを入力してください (例: 0000:01:00.0)",
			"default": "0000:01:00.0"
		},
		{
		  "id": "iommu_groupid",
		  "type": "promptString",
		  "description": "Enter IOMMU group ID (e.g. 0)",
		}
	]
}